# ── Cloudinary ──────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# ── Discord OAuth ────────────────────────────────────────
# Crea tu app en https://discord.com/developers/applications
DISCORD_CLIENT_ID=tu_client_id
DISCORD_CLIENT_SECRET=tu_client_secret
# ID del servidor de Discord para obtener los nicknames de los miembros
DISCORD_GUILD_ID=tu_guild_id_aqui

# URL de callback — en local usa http://localhost:3001/auth/discord/callback
# En producción: https://tu-backend.onrender.com/auth/discord/callback
DISCORD_CALLBACK_URL=http://localhost:3001/auth/discord/callback

# Tu Discord User ID (para permisos de administrador vía Discord OAuth)
# Discord > Ajustes > Avanzado > Modo desarrollador > clic derecho en tu usuario > Copiar ID
ADMIN_DISCORD_ID=tu_discord_user_id

# Contraseña secreta para login de admin SIN Discord
# Solo compártela con admins de confianza — no la pongas en el frontend
ADMIN_SECRET_PASSWORD=cambia_esto_por_una_clave_muy_segura

# ── Sesiones ─────────────────────────────────────────────
SESSION_SECRET=cambia_esto_por_algo_aleatorio_largo

# ── Servidor ─────────────────────────────────────────────
PORT=3001
# URL del frontend (para CORS)
FRONTEND_URL=http://127.0.0.1:5500
